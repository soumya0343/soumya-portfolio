# Copy this file to .env and fill in your values

# --- Contact form (server-side; set in Vercel project env, NOT prefixed with VITE_) ---
# Resend sends the form message to your inbox. Free tier: 3,000 emails/mo.
RESEND_API_KEY=your_resend_api_key_here
# CONTACT_TO=soumya0343@gmail.com
# Default sender onboarding@resend.dev only delivers to the Resend account owner.
# Verify a domain in Resend to send from your own address:
# CONTACT_FROM=Portfolio <hello@yourdomain.com>

# --- Ask my AI (server-side; set these in Vercel project env, NOT prefixed with VITE_) ---
# Provider-agnostic: any OpenAI-compatible /chat/completions API. All have free tiers.
# Pick ONE provider and set LLM_API_KEY (+ optionally override base/model).
LLM_API_KEY=your_free_provider_key_here

# Google Gemini (default — free tier, generous):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash
# Groq (free, very fast):
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   LLM_MODEL=openai/gpt-oss-120b
# Cerebras (free, fast):
#   LLM_BASE_URL=https://api.cerebras.ai/v1
#   LLM_MODEL=llama-3.3-70b
LLM_BASE_URL=https://api.groq.com/openai/v1
# Providers retire models; if Ask AI 502s with "model_not_found", check the current list
# at https://console.groq.com/docs/models and update this value.
LLM_MODEL=openai/gpt-oss-120b

# Note: values are read literally. Do NOT add inline "# comments" after a value.

# --- Fallback providers (optional, tried in order when the primary is rate-limited) ---
# Groq's free tier is 8k tokens/MINUTE and 200k tokens/day, and those limits are per
# ORGANISATION, so extra Groq keys from the same account share one pool and add nothing.
# A fallback only helps if it is a DIFFERENT provider.
#
# Gemini (recommended first fallback): free tier, far higher tokens/minute than Groq.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# GEMINI_MODEL=gemini-2.5-flash
#
# Cerebras: free tier exists but the account must have credit; an exhausted one
# returns 402 payment_required. Key: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# CEREBRAS_MODEL=gpt-oss-120b
